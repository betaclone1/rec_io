# Copy to .env and fill in values. Never commit .env or real secrets.
# Used by: backend (database.py, unified_config), scripts (db/, config/), load_unified_config.sh.

# ---------------------------------------------------------------------------
# Database (required for backend and DB scripts)
# backend/core/config/database.py prefers DB_* and falls back to REC_DB_*
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=rec_io_db
DB_USER=rec_io_user
DB_PASSWORD=your_password_here
DB_PORT=5432

# Alternative names (used if DB_* are unset)
# REC_DB_HOST=localhost
# REC_DB_NAME=rec_io_db
# REC_DB_USER=rec_io_user
# REC_DB_PASS=your_password_here
# REC_DB_PORT=5432
# REC_DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Backtests (scripts/backtest/helpers/db.py)
# Default when unset: local Postgres (DB_* above). Explicit REC_IO_BACKTEST_DB=local is optional.
#
# Prod backtests (opt-in): REC_IO_BACKTEST_DB=prod, REC_IO_BACKTEST_TRANSPORT=ssh (default for prod),
# REC_IO_BACKTEST_SSH=root@hostname OR REC_IO_BACKTEST_DB_HOST=hostname. Use current host from
# docs/PRODUCTION_HOST.md — not retired droplet IPs.
# REC_IO_BACKTEST_REMOTE_ENVFILE=/opt/rec_io_server/.env
#
# Direct TCP to prod (no SSH): REC_IO_BACKTEST_TRANSPORT=direct — needs REC_IO_BACKTEST_DB_HOST
# and DB_PASSWORD / REC_DB_PASS locally.
# ---------------------------------------------------------------------------
# REC_IO_BACKTEST_DB=local
# REC_IO_BACKTEST_QUIET=1
#
# REC_IO_BACKTEST_DB=prod
# REC_IO_BACKTEST_TRANSPORT=ssh
# REC_IO_BACKTEST_SSH=root@YOUR_PROD_HOST
# REC_IO_BACKTEST_DB_HOST=YOUR_PROD_HOST
# REC_IO_PRODUCTION_DB_HOST=   # alias for REC_IO_BACKTEST_DB_HOST

# ---------------------------------------------------------------------------
# Runtime (optional; backend/core/unified_config.py)
# ---------------------------------------------------------------------------
# REC_SYSTEM_HOST=localhost
# REC_BIND_HOST=0.0.0.0
# REC_TARGET_HOST=localhost
# REC_AUTO_DETECT_HOST=true
# REC_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Kalshi API (for trading; credentials may also be in backend/data/users/.../credentials/)
# ---------------------------------------------------------------------------
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=

# ---------------------------------------------------------------------------
# DigitalOcean (snapshots, backups, droplets; doctl and scripts)
# See docs/DEPLOYMENT_GUIDE.md. Never commit the real token.
# ---------------------------------------------------------------------------
# DIGITALOCEAN_API_TOKEN=
