# Copy to .env and fill in values. Never commit .env or real secrets.
# Used by: backend (database.py, unified_config), scripts (db/, config/), load_unified_config.sh.

# ---------------------------------------------------------------------------
# Database (required for backend and DB scripts)
# backend/core/config/database.py prefers DB_* and falls back to REC_DB_*
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=rec_io_db
DB_USER=rec_io_user
DB_PASSWORD=your_password_here
DB_PORT=5432

# Alternative names (used if DB_* are unset)
# REC_DB_HOST=localhost
# REC_DB_NAME=rec_io_db
# REC_DB_USER=rec_io_user
# REC_DB_PASS=your_password_here
# REC_DB_PORT=5432
# REC_DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Runtime (optional; backend/core/unified_config.py)
# ---------------------------------------------------------------------------
# REC_SYSTEM_HOST=localhost
# REC_BIND_HOST=0.0.0.0
# REC_TARGET_HOST=localhost
# REC_AUTO_DETECT_HOST=true
# REC_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Kalshi API (for trading; credentials may also be in backend/data/users/.../credentials/)
# ---------------------------------------------------------------------------
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=

# ---------------------------------------------------------------------------
# DigitalOcean (snapshots, backups, droplets; doctl and scripts)
# See docs/DEPLOYMENT_GUIDE.md. Never commit the real token.
# ---------------------------------------------------------------------------
# DIGITALOCEAN_API_TOKEN=
