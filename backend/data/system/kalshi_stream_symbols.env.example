# Copy to kalshi_stream_symbols.env on the host (gitignored via *.env), then:
#   python3 scripts/config/generate_unified_supervisor_config.py
#   supervisorctl -c backend/supervisord.conf reread
#   supervisorctl -c backend/supervisord.conf update
#   supervisorctl -c backend/supervisord.conf restart market_watchdog_ws_kalshi \
#     strike_table_generator_ws_15m strike_table_generator_ws_hourly \
#     cfbenchmarks_price_watchdog strike_snapshot_publisher
#
# Restore full streams: delete kalshi_stream_symbols.env (or set the full lists
# below), regenerate supervisord.conf, and restart the same programs.

MARKET_WATCHDOG_SYMBOLS=BTC,ETH,SOL
# Hourly orderbook window around spot: keep (2 * N + 1) contracts. Default in code is 20.
MARKET_WATCHDOG_HOURLY_ATM_STRIKES_EACH_SIDE=8
# Optional explicit overrides (defaults follow MARKET_WATCHDOG_SYMBOLS):
# STRIKE_TABLE_SYMBOLS=BTC,ETH,SOL
# STRIKE_SNAPSHOT_SYMBOLS=BTC,ETH,SOL
# CFBENCHMARKS_INDEX_IDS=BRTI,ETHUSD_RTI,SOLUSD_RTI
